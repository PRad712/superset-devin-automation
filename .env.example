# Required Devin API credentials
DEVIN_API_KEY=your_devin_api_key_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Service configuration
DEVIN_API_BASE_URL=https://api.devin.ai/v1
# Demo alternative: http://mock-devin:9000/v1
DATABASE_PATH=data/sessions.db
POLL_INTERVAL_SECONDS=30
REMEDIATION_LABEL=devin-remediate
SESSION_TAG=superset-remediation
MAX_CONCURRENT_SESSIONS=5
SUPERSET_REPO=your-org/superset
TRIGGER_TOKEN=
DISABLE_POLLER=false
