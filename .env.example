# Devin API key for creating remediation sessions
DEVIN_API_KEY=your_devin_api_key_here

# GitHub webhook secret for validating X-Hub-Signature-256
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# GitHub PAT for reading/writing issues and PRs in the Superset fork
GITHUB_PAT=your_github_pat_here

# Full repo name of the fork Devin should remediate (org/repo format)
SUPERSER_REPO=your-org/superset

# Optional: max concurrent Devin sessions (rate limiting)
MAX_CONCURRENT_SESSIONS=5
